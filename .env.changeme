# Local-only MiniMax configuration. Never commit this file.
# Paste your MiniMax API key after the equals sign to enable real model calls.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.minimax.cn/v1
LLM_PROVIDER=openai
OPENAI_MODEL=MiniMax-M3
RESPONSE_FAST_OPENAI_MODEL=MiniMax-M3
RESPONSE_QUALITY_OPENAI_MODEL=MiniMax-M3

# Until Postgres and model compatibility are verified, use temporary sessions.
OPENCOUCH_MEMORY_MODE=incognito
OPENCOUCH_TEXT_SESSION_BACKEND=disabled
OPENCOUCH_DISABLE_EMBEDDINGS=1
